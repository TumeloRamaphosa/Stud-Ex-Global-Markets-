# ============================================================
# Studex Trading Bot - Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Anthropic Claude API (optional - for advanced analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LUNO Exchange (South African Crypto)
LUNO_API_KEY=your_luno_api_key
LUNO_API_SECRET=your_luno_api_secret

# Binance Exchange (Global Crypto)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# EasyEquities (JSE Trading)
EASY_USERNAME=your_easyequities_username
EASY_PASSWORD=your_easyequities_password

# Financial Modeling Prep API (Market Data)
FMP_API_KEY=your_fmp_api_key

# TradingView Webhook Secret
TV_WEBHOOK_SECRET=your_random_secret_here

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email Notifications (optional)
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=alerts@yourdomain.com

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Ollama (local LLM on desktop)
OLLAMA_BASE_URL=http://localhost:11434

# Vercel Integration (optional - for cloud dashboard)
VERCEL_API_SECRET=your_random_secret_here
# Set this to your Vercel deployment URL once deployed:
# VERCEL_API_URL=https://studex-trading.vercel.app
