{
  "name": "studex-zernio",
  "description": "Zernio MCP — AI caption writer + social media publisher",
  "capabilities": ["caption-generation", "instagram-post", "facebook-post", "schedule-post"],
  "config": {
    "platforms": ["instagram", "facebook"],
    "caption_style": "premium-brand",
    "hashtag_limit": 15,
    "auto_schedule": true
  },
  "claude_desktop_config": {
    "command": "npx",
    "args": ["-y", "@anthropic-ai/mcp-zernio"],
    "env": {
      "ZERNIO_API_KEY": "",
      "INSTAGRAM_ACCESS_TOKEN": "",
      "FACEBOOK_PAGE_TOKEN": ""
    }
  },
  "integration": {
    "composio_fallback": true,
    "composio_route": "/api/composio/post"
  }
}
