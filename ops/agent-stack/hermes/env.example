# Copy to ~/.hermes/.env and chmod 600.
# MiniMax Token Plan subscription key (NOT the pay-as-you-go API key).
# https://platform.minimax.io → Token Plan
MINIMAX_API_KEY=

# Only if you use the China endpoint (hermes provider: minimax-cn)
# MINIMAX_CN_API_KEY=

# Optional: Cursor Cloud Agents from Hermes
# CURSOR_API_KEY=

# Optional: Orgo computers from Hermes / OpenClaw
# ORGO_API_KEY=
