{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch",
    "base",
    "pushed",
    "change_summary",
    "verification",
    "deviations",
    "known_limitations"
  ],
  "properties": {
    "branch": { "type": "string" },
    "base": { "type": "string" },
    "pushed": { "type": "boolean" },
    "change_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change"],
        "properties": {
          "path": { "type": "string" },
          "change": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result"],
        "properties": {
          "command": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "deviations": { "type": "array", "items": { "type": "string" } },
    "known_limitations": { "type": "array", "items": { "type": "string" } }
  }
}
