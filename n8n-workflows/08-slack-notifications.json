    {
      "id": "slack-general",
      "name": "Post to #general-notifications",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [940, 640],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "channel": {
          "__rl": true,
          "value": "#general-notifications",
          "mode": "name"
        },
        "messageType": "block",
        "blocksUi": "={{ JSON.stringify([{ type: 'header', text: { type: 'plain_text', text: $json.title } }, { type: 'section', text: { type: 'mrkdwn', text: $json.message } }, { type: 'context', elements: [{ type: 'mrkdwn', text: ':bell: ' + ($json.source || 'Unknown') + ' | ' + $json.timestamp }] }, { type: 'divider' }]) }}",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "slack-cred-placeholder",
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "Receive Events": {
      "main": [
        [
          {
            "node": "Parse Event Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Event Data": {
      "main": [
        [
          {
            "node": "Route to Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route to Channel": {
      "main": [
        [
          {
            "node": "Post to #facebook",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Post to #instagram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Post to #orders",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Post to #google-ads",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Post to #whatsapp",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Post to #general-notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
