{
  "name": "Stud-Ex Meat: Invoice Automation",
  "nodes": [
    {
      "id": "gsheets-trigger",
      "name": "Watch Production Sheet",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "1tnBDwEA_BKJMLrXJEVr75YeVh5PK8kgoi9lCRz3k1XY",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Production",
          "mode": "name"
        },
        "event": "rowAdded",
        "options": {
          "valueRenderMode": "FORMATTED_VALUE"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "gsheets-cred-placeholder",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "id": "filter-pending",
      "name": "Filter Pending Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "jsCode": "// Filter rows where Status is \"Pending\" and have not been processed\nconst items = $input.all();\nconst pendingItems = [];\n\nfor (const item of items) {\n  const status = (item.json.Status || item.json.status || '').toString().trim();\n  const invoiceId = (item.json['Invoice ID'] || item.json.invoiceId || '').toString().trim();\n\n  if (status.toLowerCase() === 'pending' && invoiceId === '') {\n    pendingItems.push(item);\n  }\n}\n\nif (pendingItems.length === 0) {\n  // Return empty to stop the workflow if no pending rows\n  return [];\n}\n\nreturn pendingItems;"
      }
    },
    {
      "id": "calculate-totals",
      "name": "Calculate Invoice Totals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "jsCode": "// Calculate line item totals, subtotal, tax (VAT 15%), and grand total\nconst items = $input.all();\nconst VAT_RATE = 0.15;\n\nconst results = [];\n\nfor (const item of items) {\n  const row = item.json;\n\n  // Parse line items from the production sheet row\n  // Each row represents a line item with Cut, Marble Score, Weight, Price per Cut\n  const cut = row['Cut'] || row.cut || '';\n  const marbleScore = row['Marble Score'] || row.marbleScore || '';\n  const weight = parseFloat(row['Weight'] || row.weight || 0);\n  const pricePerCut = parseFloat(row['Price per Cut'] || row['Price'] || row.pricePerCut || 0);\n  const customerName = row['Customer Name'] || row.customerName || '';\n  const customerEmail = row['Customer Email'] || row.customerEmail || '';\n  const rowNumber = row['row_number'] || row.rowNumber || row['__row'] || '';\n\n  // Calculate item total\n  const itemTotal = weight * pricePerCut;\n\n  // For single-row items, subtotal equals item total\n  // When batching multiple items per customer, aggregate in a downstream node\n  const subtotal = itemTotal;\n  const tax = Math.round(subtotal * VAT_RATE * 100) / 100;\n  const grandTotal = Math.round((subtotal + tax) * 100) / 100;\n\n  results.push({\n    json: {\n      customerName,\n      customerEmail,\n      cut,\n      marbleScore,\n      weight,\n      pricePerCut,\n      itemTotal: Math.round(itemTotal * 100) / 100,\n      subtotal: Math.round(subtotal * 100) / 100,\n      tax,\n      grandTotal,\n      vatRate: VAT_RATE * 100,\n      rowNumber,\n      currency: 'ZAR',\n      invoiceDate: new Date().toISOString().split('T')[0],\n      description: `${cut} - Marble Score: ${marbleScore} - ${weight}kg @ R${pricePerCut}/kg`\n    }\n  });\n}\n\nreturn results;"
      }
    },
    {
      "id": "search-customer",
      "name": "QuickBooks - Search Customer",
      "type": "n8n-nodes-base.quickbooks",
      "typeVersion": 1,
      "position": [960, 300],
      "parameters": {
        "operation": "getAll",
        "resource": "customer",
        "filters": {
          "query": "={{ 'SELECT * FROM Customer WHERE DisplayName = \\'' + $json.customerName.replace(/'/g, \"\\\\'\" ) + '\\'' }}"
        },
        "limit": 1
      },
      "credentials": {
        "quickBooksOAuth2Api": {
          "id": "quickbooks-cred-placeholder",
          "name": "QuickBooks OAuth2"
        }
      }
    },
    {
